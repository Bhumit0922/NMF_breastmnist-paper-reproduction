Count</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>0</td>\n      <td>210</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>1</td>\n      <td>570</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"\nFeature statistics\n------------------\nMinimum: 0.0\nMaximum: 16.87645\nMean: 0.34190568\nStd: 0.8603065\n","output_type":"stream"}],"execution_count":49},{"id":"e584a6fb-68a7-4f73-935c-c5b8b0ba221b","cell_type":"markdown","source":"## Frozen experimental episodes\n\nThe same 10 episodes are reused across Feature Space, SVD, NMF, DNMF and SCNMFS. This is important because every method is evaluated on the same train/test samples.\n\nThe class proportions follow the complete dataset distribution, and training/test samples are disjoint.\n","metadata":{}},{"id":"4bbce6f0-7d79-48a9-829c-426c0daeaad7","cell_type":"code","source":"def create_proportional_episode(\n    X,\n    y,\n    train_size,\n    test_size,\n    random_state=42\n):\n    rng = np.random.default_rng(random_state)\n\n    classes, original_counts = np.unique(\n        y,\n        return_counts=True\n    )\n\n    total_size = train_size + test_size\n\n    class_indices = {}\n\n    for cls in classes:\n        indices = np.where(y == cls)[0]\n        class_indices[cls] = rng.permutation(indices)\n\n    proportions = original_counts / len(y)\n\n    total_per_class = np.floor(\n        proportions * total_size\n    ).astype(int)\n\n    remainder = total_size - total_per_class.sum()\n\n    if remainder > 0:\n        fractional = (\n            proportions * total_size\n            - total_per_class\n        )\n\n        order = np.argsort(-fractional)\n\n        for i in order[:remainder]:\n            total_per_class[i] += 1\n\n    train_indices = []\n    test_indices = []\n\n    for i, cls in enumerate(classes):\n\n        n_total = total_per_class[i]\n\n        n_train = int(\n            round(\n                n_total\n                * 