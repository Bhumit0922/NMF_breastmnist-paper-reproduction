e_processed.std().item())\nprint(\"Minimum:\", sample_processed.min().item())\nprint(\"Maximum:\", sample_processed.max().item())\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-26T19:41:06.859161Z","iopub.execute_input":"2026-08-26T19:41:06.859565Z","iopub.status.idle":"2026-08-26T19:41:06.871709Z","shell.execute_reply.started":"2026-08-26T19:41:06.859534Z","shell.execute_reply":"2026-08-26T19:41:06.870967Z"}},"outputs":[{"name":"stdout","text":"Processed shape: torch.Size([3, 224, 224])\nDtype: torch.float32\nMean: 0.4576994776725769\nStd: 0.2117917537689209\nMinimum: 0.0\nMaximum: 1.0\n","output_type":"stream"}],"execution_count":45},{"id":"eaa0c56e-889d-4154-8248-603c98a45e44","cell_type":"code","source":"train_dataset = BreastMNIST(\n    split=\"train\",\n    transform=exact_paper_transform,\n    download=False\n)\n\nval_dataset = BreastMNIST(\n    split=\"val\",\n    transform=exact_paper_transform,\n    download=False\n)\n\ntest_dataset = BreastMNIST(\n    split=\"test\",\n    transform=exact_paper_transform,\n    download=False\n)\n\nBATCH_SIZE = 64\n\ntrain_loader = DataLoader(\n    train_dataset,\n    batch_size=BATCH_SIZE,\n    shuffle=False,\n    num_workers=2\n)\n\nval_loader = DataLoader(\n    val_dataset,\n    batch_size=BATCH_SIZE,\n    shuffle=False,\n    num_workers=2\n)\n\ntest_loader = DataLoader(\n    test_dataset,\n    batch_size=BATCH_SIZE,\n    shuffle=False,\n    num_workers=2\n)\n\nprint(\"Paper-preprocessed DataLoaders created.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-26T19:41:06.872619Z","iopub.execute_input":"2026-08-26T19:41:06.872859Z","iopub.status.idle":"2026-08-26T19:41:06.888683Z","shell.execute_reply.started":"2026-08-26T19:41:06.872838Z","shell.execute_reply":"2026-08-26T19:41:06.888012Z"}},"outputs":[{"name":"stdout","text":"Paper-preprocessed DataLoaders created.\n","output_type":"stream"}],"execution_count":46},{"id":"9f17e2f6-5dd1-4fb8-bf8c-bb4aadf65182","cell_type":"code","source":"# ============================================================\n# 7. RESNET18 FEATURE EXTRACTOR\n# ============================================================\n\nweights = ResNet18_Weights.DEFAULT\n\nmodel = resnet18(weights=weights)\nmodel.fc = nn.Identity()\n\nmodel = model.to(device)\nmodel.eval()\n\nfor param in model.parameters():\n    param.requires_grad = False\n\nprint(\"ResNet18 feature extractor ready.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-26T19:41:06.890626Z","iopub.execute_input":"2026-08-26T19:41:06.890919Z","iopub.status.idle":"2026-08-26T19:41:07.073516Z","shell.execute_reply.started":"2026-08-26T19:41:06.890897Z","shell.execute_reply":"2026-08-26T19:41:07.072788Z"}},"outputs":[{"name":"stdout","text":"ResNet18 feature extractor ready.\n","output_type":"stream"}],"execution_count":47},{"id":"d0971b2d-a742-4eb3-82ae-b85f243020da","cell_type":"code","source":"def extract_features(model, dataloader, device):\n    features = []\n    labels = []\n\n    model.eval()\n\n    with torch.no_grad():\n        for images, batch_labels in dataloader:\n\n            images = images.to(device)\n\n            batch_features = model(images)\n\n            features.append(\n                batch_features.cpu().numpy()\n            )\n\n            labels.append(\n                batch_labels.numpy()\n            )\n\n    features = np.concatenate(features, axis=0)\n    labels = np.concatenate(labels, axis=0).reshape(-1)\n\n    return features, labels\n\n\nX_train, y_train = extract_features(\n    model,\n    train_loader,\n    device\n)\n\nX_val, y_val = extract_features(\n    model,\n    val_loader,\n    device\n)\n\nX_test, y_test = extract_features(\n    model,\n    test_loader,\n    device\n)\n\nprint(\"Train features:\", X_train.shape)\nprint(\"Validation features:\", X_val.shape)\nprint(\"Test features:\", X_test.shape)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-26T19:41:07.074481Z",